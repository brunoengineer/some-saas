# Settings for the sync script (npm run sync / npm run sync:watch).
# Copy this file to .env.sync and fill it in. .env.sync is never committed.
# Step-by-step guide: docs/discord.md

# Discord Developer Portal → your application → Bot → Reset Token. Treat it like a password.
DISCORD_BOT_TOKEN=

# Firebase console → Project settings → Service accounts → Generate new private key.
# Save the file in the secrets/ folder of this project (ignored by git) and put its path here.
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json

# First run only: how many days of joins and messages to look back (1-30).
SYNC_BACKFILL_DAYS=14
