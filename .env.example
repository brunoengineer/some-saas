# Copy this file to .env.local and fill in the values from the Firebase console:
# Project settings (gear icon) → General → Your apps → Web app → SDK setup and configuration → Config.
# Leave them empty to run the prototype (sample data in your browser, no sign-in).
# These values identify the project to the browser; they are not secrets. Sign-in and firestore.rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
